# Invalidity problems (notation 2).
# Format: see data/README.md. Fields:
#   problem:                 problem name, as shown in the problem list
#   options:                 per-problem options, e.g. eg (a worked example)
#   note:                    note shown under the problem title
#   common-name:             common name of the problem (course database)
#   original-name:           name the problem was copied from
#   errors:                  error count (saved work)
#   seconds:                 time worked, in seconds (saved work)
#   argument:                the argument to show invalid
#   universe-size:           size of the universe
#   interpretation:          interpretations, separated by '.'
#   workspace:               free-form workspace text (encoded)

# baseinvprobs.txt: base homework problems; syntax 2

## 
##                          CHAPTER III
##           MONADIC PREDICATE LOGIC
## 

problem: Inval 3.113
argument: .:  @x(Fx->@xFx)
common-name: Inval 3.113

problem: Inval 3.114
argument: @xFx->P  .:  @x(Fx->P)
common-name: Inval 3.114

problem: Inval 3.115
argument: !x(Fx->P)  .:  !xFx->P
common-name: Inval 3.115

problem: Inval 3.116
argument: .:~(!x~Fx&(Fa&Fb))
common-name: Inval 3.116

problem: Inval 3.117
argument: @x!y(Fx<->Gy)  .:  !y@x(Fx<->Gy)
common-name: Inval 3.117

problem: Inval 3.118(i)
argument: !x(Fx&~Gx).  !x(Gx&~Fx)  .:  @x(Fx|Gx)
common-name: Inval 3.118(i)

problem: Inval 3.118(iii)
argument: !xFx.  !xGx.  !xHx.  @x((Fx&Gx)|(Fx&Hx)|(Gx&Hx)->Jx)  .:  !xJx
common-name: Inval 3.118(iii)

problem: Inval 3.201
argument: @xFx->@xGx  .:  @x(Fx->Gx)
common-name: Inval 3.201

problem: Inval 3.202
argument: .:  !x(@yFy<->~Fx)
common-name: Inval 3.202

problem: Inval 3.203
argument: @x(Fx<->Gx)  .:  (~!xFx&~!xGx)|(@xFx&@xGx)
common-name: Inval 3.203

problem: Inval 3.204
argument: !xFx.  @xGx  .:  ~@x(Fx<->Gx)
common-name: Inval 3.204

problem: Inval 3.205
argument: @x(Fx<->Gx)  .:  (!x~Fx->!xGx)
common-name: Inval 3.205

problem: Inval 3.206
argument: ~@x(Fx->Gx)  .:  ~!x@y(Fy->Gx)
common-name: Inval 3.206

problem: Inval 3.207
argument: !x(Fx&Gx)  .:  @x!y(Fy&Gx)
common-name: Inval 3.207

