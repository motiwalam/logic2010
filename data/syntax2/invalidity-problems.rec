## 
##                          CHAPTER IV
##                    PREDICATE LOGIC
## 

problem: Inval 4.001
argument: @x!yF(xy).  ~!xF(xx)  .:  @x@y(F(xy)->F(yx))
common-name: Inval 4.001

problem: Inval 4.002
argument: !x!yF(xy).  @y(!xF(xy)->@xF(xy))  .:  @xF(xx)
common-name: Inval 4.002

problem: Inval 4.003
argument: @x!y@z(R(zy)<->Gz&R(zx))  .:  !x@y(R(yx)<->Gy)
common-name: Inval 4.003

problem: Inval 4.004
argument: @x(Fx->!y(Gy&R(xy)))  .:  @x(Gx->!y(Fy&R(yx)))
common-name: Inval 4.004

problem: Inval 4.155
argument: @x@y@z(F(xy)&F(yz)->F(xz)).  @x@y(F(xy)->F(yx))  .:  @xF(xx)
common-name: Inval 4.155

problem: Inval 4.156
argument: !x!yF(xy)  .:  !yF(yy)
common-name: Inval 4.156

problem: Inval 4.157
argument: @x!y(F(xy)|F(yx))  .:  @x!yF(xy)
common-name: Inval 4.157

problem: Inval 4.160
argument: @xF(xa(x))  .:  !xF(a(x)x)
common-name: Inval 4.160

## 
##                          CHAPTER V
##                            IDENTITY
## 

problem: Inval 5.001
argument: !x@y(Fy&Gy<->x=y)  .:  !x@y(Fx&(Gy<->x=y))
common-name: Inval 5.001

problem: Inval 5.002
argument: @x(Fx->!y@z(Gz&R(xz)<->y=z)).  @x(Gx->!y@z(Fz&R(xz)<->y=z))  .:  @x@y(Fx&Gy&R(xy)->R(yx))
common-name: Inval 5.002

## 
##                          CHAPTER VI
##                       DESCRIPTIONS
## 

problem: Inval 6.001
argument: %xFx=a  .:  @x(Fx<->x=a)
interpretation: F(1)
common-name: Inval 6.001

problem: Inval 6.002
argument: F%xFx  .:  !y@x(Fx<->x=y)
interpretation: F(1)
common-name: Inval 6.002

problem: Inval 6.003
argument: %xFx=%xx<>x  .:  ~!y@x(Fx<->x=y)
interpretation: F(1)
common-name: Inval 6.003

problem: Inval 6.004
argument: %xFx=%xGx  .:  @x(Fx<->Gx)
interpretation: F(1).G(1)
common-name: Inval 6.004

problem: Inval 6.005
argument: !x a(x)=b(x)  .:  @y %xa(x)=y = %xb(x)=y
interpretation: a(1).b(1)
common-name: Inval 6.005

problem: Inval 6.006
argument: F%xR(xa(x))  .:  !yF%xR(xy)
interpretation: F(1).R(2).a(1)
common-name: Inval 6.006

problem: Inval 6.007
argument: .:  !y y=%xR(xy)
interpretation: R(2)
common-name: Inval 6.007

problem: Inval 6.008
argument: @z~!y@x(Hz<->x=y)  .:  %zHz = %xx<>x
interpretation: H(1)
common-name: Inval 6.008

problem: Inval 6.009
argument: !y@x(R(xy)<->x=y)  .:  R(%xR(xy) y)
interpretation: R(2)
common-name: Inval 6.009

problem: Inval 6.010
argument: !y!x(R(xx)<->x=y)  .:  !y@x(R(x%xR(xx))<->x=y)
interpretation: R(2)
common-name: Inval 6.010

problem: Inval 6.011
argument: !y@x(Fx<->x=y).  ~!y@x(~Fx<->x=y)  .:  %xFx=%x~Fx
interpretation: F(1)
common-name: Inval 6.011

problem: Inval 6.012
argument: !y@x(Fx<->x=y).  ~!y@x(Gx<->x=y)  .:  %xFx<>%xGx
interpretation: F(1).G(1)
common-name: Inval 6.012
