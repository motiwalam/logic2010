# core.mapping -- survey-phase names for the central classes of logic.jar.
# Class lines use the ORIGINAL obfuscated name (see "# classes" in ids.txt);
# the placeholder is given in the trailing comment.

## ---------------------------------------------------------------- constants / shared interfaces
class nA LogicConstants               # C_n_A: colors (bruinGold..), symbol tables (maggie/kaplan*/html*), letter sets
class XC ModuleConstants              # C_XC: derModule..truModule, moduleNames/moduleWorks/moduleClasses
class DE DerivationConstants          # C_DE: EXPR_PARSE.., ASS_DD.., SCHEME_FAILED..
class aD ExpressionKinds              # C_a_D: int kind codes 0..7 used by Expression.kind
class AF CellRenderable               # C_AF: prerender/setCellForeground/setCellBackground
class $B DerivationNode               # C_0B: implemented by DerivationBox and DerivationLine
class v ResponseHandler               # C_v_: server-response sink: m4(error, params) / m5()

